# Copy this file to server/.env and fill in real values before starting the server.

# Port the Node app listens on internally (Nginx will proxy to this)
PORT=4000

# IMPORTANT: replace with a long random string in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret

# Your site's origin, e.g. http://YOUR_SERVER_IP or https://yourdomain.com
# Used for CORS. You can leave this out entirely if frontend and API are served
# from the same origin (which they are in this setup).
CLIENT_ORIGIN=http://YOUR_SERVER_IP
